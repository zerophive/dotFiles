#!/usr/bin/env bash
#################################################
# set the terminal title, prompt and properties #
#################################################
export PS1="[\h:\w] \u% "
#export PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND; }history -a"
export PROMPT_COMMAND="history -a; history -c; history -r"

# keep Ghostty shell integration hooks (bash 3.2 is not auto-injected)
if [[ "$TERM_PROGRAM" == "ghostty" && -r "$GHOSTTY_RESOURCES_DIR/shell-integration/bash/ghostty.bash" ]]; then
    source "$GHOSTTY_RESOURCES_DIR/shell-integration/bash/ghostty.bash"
fi

# Ghostty pass-through from tmux
if [[ -n "$TMUX" ]]; then
    __osc7_tmux() { printf '\ePtmux;\e\e]7;file://%s%s\a\e\\' "$HOSTNAME" "${PWD// /%20}"; }
    PROMPT_COMMAND="__osc7_tmux; ${PROMPT_COMMAND}"
fi
